# Google Form newsletter signup (leave unset to fall back to Netlify Forms).
# FORM_ID is the long id in https://docs.google.com/forms/d/e/<FORM_ID>/viewform
VITE_GOOGLE_FORM_ID=
# EMAIL_ENTRY is the field's entry id, e.g. "123456789" (or "entry.123456789").
VITE_GOOGLE_FORM_EMAIL_ENTRY=

# Clerk authentication. Get this from the Clerk Dashboard (API Keys).
VITE_CLERK_PUBLISHABLE_KEY=

# Neon Data API base URL (Data API page in the Neon Console).
# It ends with /rest/v1, e.g. https://<host>/<db>/rest/v1
VITE_NEON_DATA_API_URL=

# Paystack public key (client-side). Safe to expose; use pk_test_ locally and
# pk_live_ in production. Get it from the Paystack Dashboard.
VITE_PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-only values. Do NOT prefix these with VITE_ — they are read by the
# Netlify Functions in netlify/functions and must never reach the browser.
# ---------------------------------------------------------------------------
# Paystack secret key (sk_test_... / sk_live_...). Used to verify transactions
# and to validate webhook signatures.
PAYSTACK_SECRET_KEY=
# Clerk secret key (sk_test_... / sk_live_...). Used to verify the caller's
# session token before linking a donation to a user.
CLERK_SECRET_KEY=
# Neon Postgres connection string (postgresql://...). Use the database owner
# connection so RLS does not block the trusted write; the client keeps using
# the Data API for reads.
DATABASE_URL=
